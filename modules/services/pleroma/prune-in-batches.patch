+
+  # Deleting a Create activity updates the row of its instance in counter_cache
+  # and keeps that row locked until the transaction ends. Until then, no new
+  # post from that instance can be inserted. The activities are therefore
+  # walked in the order of their ids and deleted in batches, each in its own
+  # short transaction.
+  @orphaned_activities_batch_size 5_000
+
+  defp prune_orphaned_activities(orphan_queries, last_id \\ <<0::128>>, deleted \\ 0) do
+    {:ok, %{rows: rows}} =
+      Repo.query(
+        "select id from public.activities where id > $1 order by id limit $2",
+        [last_id, @orphaned_activities_batch_size],
+        timeout: :infinity
+      )
+
+    case List.flatten(rows) do
+      [] ->
+        deleted
+
+      batch ->
+        orphans =
+          Enum.flat_map(orphan_queries, fn query ->
+            {:ok, %{rows: rows}} = Repo.query(query, [batch], timeout: :infinity)
+            List.flatten(rows)
+          end)
+
+        {:ok, %{num_rows: count}} =
+          Repo.query(
+            "delete from public.activities where id = any($1)",
+            [orphans],
+            timeout: :infinity
+          )
+
+        prune_orphaned_activities(orphan_queries, List.last(batch), deleted + count)
+    end
+  end
 end
